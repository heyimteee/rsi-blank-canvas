PORT=4000
# Docker: postgres://postgres:postgres@localhost:5432/rsi_db
# Homebrew local (macOS): postgres://tristan@localhost:5432/rsi_db  (replace tristan with `whoami`)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rsi_db
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=replace-with-brevo-login
SMTP_PASS=replace-with-brevo-key
MAIL_FROM=BCC IS <noreply@example.com>
SMTP_ENABLED=false
